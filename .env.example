# ==============================================================================
# Autonomous Agents Hub - Environment Template (Variables Names ONLY - No Secrets)
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Authentication & API Security
HUB_AUTH_TOKEN=

# AI Model Provider Keys (For Maestro & Specialized Agents)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Infisical Central Secrets Management (Cloud Machine Identity)
INFISICAL_SITE_URL=https://app.infisical.com
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=development

# Storage & Database (SQLite local by default, PostgreSQL cloud expansion)
DATABASE_URL=sqlite:///agents_hub.db
